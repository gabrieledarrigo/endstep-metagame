{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/metagame/:path*",
      "destination": "/api/metagame?path=:path*"
    },
    {
      "source": "/decks/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/matchups",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
