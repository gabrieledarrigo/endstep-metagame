{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/metagame/:path*",
      "destination": "/api/metagame?path=:path*"
    },
    {
      "source": "/decks/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/matchups",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-hQN8LN6XjySGwkpj/mFz4PlNVJ9hEdz7bL69MDGhUdI='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https://endstep.cc https://cards.scryfall.io; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
