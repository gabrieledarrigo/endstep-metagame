{
  "framework": "vite",
  "functions": {
    "api/deck-page.ts": {
      "includeFiles": "dist/index.html"
    },
    "api/sample-cards.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/metagame/:path*",
      "destination": "/api/metagame?path=:path*"
    },
    {
      "source": "/decks/:slug",
      "destination": "/api/deck-page?slug=:slug"
    },
    {
      "source": "/matchups",
      "destination": "/index.html"
    },
    {
      "source": "/what-to-play",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-vUZvid443lEF8KCCRsxu9Vzo4WyvKcWFxzjyQGHwT9U='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https://endstep.cc https://cards.scryfall.io; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
